  "temporaryDirectUiDebt": {},
  "rulesForFutureFeatures": {
    "newDataServiceMustBeRegistered": true,
    "newOfflineReadableDomainMustUseSmartCache": true,
    "newMutableOfflineReadableDomainMustUseDeltaSync": true,
    "newOfflineCreateUpdateMustUseOfflineQueue": true,
    "directSupabaseCallsFromUiAreForbidden": true,
    "offlineDeleteRequiresExplicitDesignAndTombstoneStrategy": true,
    "securitySensitiveAdminWritesRemainOnlineOnlyUnlessSeparatelyApproved": true,
    "offlineDeleteMustUseServerTombstoneFeed": true,
    "offlineDeleteMustUseBaseVersionConflictGuard": true,
    "idempotencyLedgerPruningRequiresBoundedReplayHorizon": true,
    "expiredQueueReplayRequiresManualRecovery": true,
    "queueBackedReplayHorizonMustBeServerEnforced": true,
    "legacyReplayRpcMustHaveBoundedCutoverGrace": true,
    "financialRetryHorizonMustBeServerEnforced": true,
    "financialResultLedgerPruningRequiresExpiredReplayGuard": true,
    "financialReplayGuardMustOutliveResultLedger": true,
    "ledgerPruningMustUseServerEligibilityGuard": true,
    "ledgerPruningRequiresReplayGuardCoverage": true,
    "ledgerPruningDryRunMustPrecedeDeleteEnablement": true,
    "historicalReplayGuardBackfillMustGrantFreshServerGrace": true,
    "historicalReplayGuardBackfillMustNotExtendExistingGuards": true,
    "ledgerPruningEngineMustDefaultDisabled": true,
    "ledgerPruningBatchMustBeBounded": true,
    "ledgerPruningRequiresSeparateActivationMigration": true,
    "ledgerPruningMustPreserveReplayGuards": true,
    "ledgerPruningRunMustBeAuditedWithoutBusinessPayload": true
  }
}
